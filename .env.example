# Copy to .env.local and fill in live values when you push to Supabase.
# The demo runs fine without these — pages fall back to the built-in collection.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin studio PIN (defaults to "alwankhat" if unset)
NEXT_PUBLIC_ADMIN_PIN=alwankhat

# Razorpay (when checkout goes live)
NEXT_PUBLIC_RAZORPAY_KEY_ID=